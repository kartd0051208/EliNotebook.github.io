{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/finance-line-summary-v1.schema.json",
  "title": "EliNotebook LINE Finance Summary v1",
  "description": "未來由已驗證後端產生的最小財務摘要；不得加入密碼、金鑰或完整交易明細。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "asOf",
    "availableFunds",
    "currentBalance",
    "reserveAmount",
    "dueBeforePayday",
    "payday",
    "daysUntilPayday",
    "installmentRemainingAmount",
    "activeInstallmentCount",
    "overdueInstallmentCount"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "asOf": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "availableFunds": { "type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991 },
    "currentBalance": { "type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991 },
    "reserveAmount": { "type": "integer", "minimum": 0, "maximum": 999999999999 },
    "dueBeforePayday": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "payday": { "type": "string", "pattern": "^(|\\d{4}-\\d{2}-\\d{2})$" },
    "daysUntilPayday": { "type": ["integer", "null"], "minimum": 0, "maximum": 31 },
    "installmentRemainingAmount": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "activeInstallmentCount": { "type": "integer", "minimum": 0, "maximum": 200 },
    "overdueInstallmentCount": { "type": "integer", "minimum": 0, "maximum": 200 }
  }
}
